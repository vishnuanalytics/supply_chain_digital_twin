# LLM providers, tried in this order with automatic fallback on error/timeout.
LLM_PROVIDER_ORDER=groq,openrouter,anthropic

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Neo4j (AuraDB free tier)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# PostgreSQL (Neon)
POSTGRES_URL=

# The seed data is authored as of this fixed date so demo answers ("expiring
# in 90 days", "this month's billing", etc.) stay consistent no matter when
# you actually run the app. Only change this if you regenerate the seed data
# for a different reference date.
DEMO_REFERENCE_DATE=2026-09-21

# Optional (build step 8) - TypeSafe AI's Jev fast/cheap typed-decision model as a
# swappable alternative to a full LLM call for classify_query's routing decision.
# Leave blank to always use the normal Claude/Groq path - https://typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional (build step 8) - LangSmith tracing of every node + LLM call.
# Leave LANGSMITH_TRACING=false (or unset) to disable - https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supply-chain-digital-twin
